# Copy to .env and fill in. Never commit the real .env (see module 16 §7.7).

# Postgres (module 16)
DATABASE_URL=postgresql+psycopg://grants:grants@localhost:5432/grant_discovery

# Redis — LLM job queue (module 16) + crawl rate-limiter state (module 04)
REDIS_URL=redis://localhost:6379/0

# Ollama host, served over Tailscale (module 08 / 16)
OLLAMA_HOST=http://<tailscale-host>:11434
OLLAMA_MODEL=

# Discovery (module 03)
SERPER_API_KEY=

# Delivery — Monday digest (module 14)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=grants@techonhand.org
GRANTS_TEAM_RECIPIENTS=

# Monitoring alerts (module 16)
ALERT_EMAIL_TO=
ALERT_SLACK_WEBHOOK_URL=

# Object storage (module 16) — set only if using MinIO instead of local filesystem
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_PATH=./data/objects
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Crawl policy (module 04)
CRAWL_USER_AGENT="TechOnHandGrantBot/1.0 (+https://techonhand.org/bot; grants@techonhand.org)"
